{
  "name": "@share/source",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "serve:api": "nx serve api",
    "gen:types:refitter": "refitter --settings-file .refitter --skip-validation",
    "gen:types": "openapi-typescript http://localhost:5080/openapi/v1.json -o libs/api/api-types/src/lib/schema.ts",
    "gen:types:local": "openapi-typescript apps/api/Api.json -o libs/api/api-types/src/lib/schema.ts",
    "generate:api-types": "start-server-and-test serve:api http-get://localhost:5080/openapi/v1.json gen:types",
    "generate:refitter-types": "start-server-and-test serve:api http-get://localhost:5080/openapi/v1.json gen:types:refitter",
    "lint:all": "nx run-many -t lint --all"
  },
  "private": true,
  "devDependencies": {
    "nx": "22.7.5",
    "openapi-typescript": "^7.13.0",
    "start-server-and-test": "^3.0.11"
  }
}
