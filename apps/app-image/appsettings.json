{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppImage": {
    "WebRoot": "/app/web",
    "Api": {
      "Destination": "http://127.0.0.1:5000/",
      "PathPrefix": "/api",
      "StripPathPrefix": true,
      "HealthPath": "/health",
      "HealthTimeoutSeconds": 5
    },
    "ForwardedHeaders": {
      "TrustAllProxies": false
    }
  }
}
