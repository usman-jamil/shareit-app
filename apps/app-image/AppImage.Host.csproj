<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AppImage.Host</RootNamespace>
    <AssemblyName>AppImage.Host</AssemblyName>
    <!-- The host serves files from a configured directory, never from wwwroot. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- No culture-sensitive formatting anywhere in this host; drops the libicu dependency. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <Version>0.1.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nx project metadata and container assets are inputs to the image build, not app content. -->
    <Content Update="project.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
